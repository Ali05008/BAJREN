<?xml version="1.0" encoding="utf-8"?>
<!-- BAJREN branded launch screen: brand near-black background + centered
     logo mark. Shown natively before the Flutter engine draws its first
     frame, then handed off to lib/features/splash/presentation/screens/
     splash_screen.dart so there's no color flash during the handoff. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />

    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
