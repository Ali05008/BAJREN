{
  "rules": {
    ".read": false,
    ".write": false,

    "signaling": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$msgId": {
          ".write": "auth != null && auth.uid === newData.child('fromUserId').val() && newData.child('toUserId').val() === $toUid && newData.child('callId').isString() && newData.child('type').isString()",
          ".validate": "newData.hasChildren(['callId', 'type', 'payload', 'fromUserId', 'toUserId', 'timestamp']) && newData.child('fromUserId').val() === auth.uid"
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admin_roles').child(auth.uid).val() === 'MODERATOR' || root.child('admin_roles').child(auth.uid).val() === 'ADMIN' || root.child('admin_roles').child(auth.uid).val() === 'SUPER_ADMIN')",
        ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.child('role').exists() == data.child('role').exists() && newData.child('role').val() == data.child('role').val() && newData.child('status').exists() == data.child('status').exists() && newData.child('status').val() == data.child('status').val() && newData.child('statusReason').exists() == data.child('statusReason').exists() && newData.child('statusReason').val() == data.child('statusReason').val() && newData.child('suspendedUntil').exists() == data.child('suspendedUntil').exists() && newData.child('suspendedUntil').val() == data.child('suspendedUntil').val() && newData.child('isVerified').exists() == data.child('isVerified').exists() && newData.child('isVerified').val() == data.child('isVerified').val() && newData.child('permissions').exists() == data.child('permissions').exists()",
        "role": {
          ".validate": "newData.val() == data.val()"
        },
        "status": {
          ".validate": "newData.val() == data.val()"
        },
        "statusReason": {
          ".validate": "newData.val() == data.val()"
        },
        "suspendedUntil": {
          ".validate": "newData.val() == data.val()"
        },
        "isVerified": {
          ".validate": "newData.val() == data.val()"
        },
        "permissions": {
          ".validate": "newData.val() == data.val()"
        }
      }
    },

    "admin_roles": {
      ".read": "auth != null && (root.child('admin_roles').child(auth.uid).val() === 'ADMIN' || root.child('admin_roles').child(auth.uid).val() === 'SUPER_ADMIN')",
      ".write": false
    },

    "admin_stats": {
      ".read": "auth != null && root.child('admin_roles').child(auth.uid).exists() && root.child('admin_roles').child(auth.uid).val() !== 'USER'",
      ".write": false
    },

    "reports": {
      ".indexOn": ["reporterId"],
      "$reportId": {
        ".read": "auth != null && (data.child('reporterId').val() === auth.uid || root.child('admin_roles').child(auth.uid).val() === 'MODERATOR' || root.child('admin_roles').child(auth.uid).val() === 'ADMIN' || root.child('admin_roles').child(auth.uid).val() === 'SUPER_ADMIN')",
        ".write": false
      }
    },

    "audit_logs": {
      ".read": "auth != null && (root.child('admin_roles').child(auth.uid).val() === 'ADMIN' || root.child('admin_roles').child(auth.uid).val() === 'SUPER_ADMIN')",
      ".write": false
    },

    "contacts": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        "$contactUid": {
          ".write": "auth != null && (auth.uid === $ownerUid || auth.uid === $contactUid) && $ownerUid !== $contactUid && (!data.exists() || !newData.exists()) && (auth.uid === $ownerUid || newData.exists() == false || root.child('privacy').child($ownerUid).child('allowContactBy').val() !== 'nobody')",
          ".validate": "newData.hasChildren(['addedAt', 'displayName']) && newData.child('addedAt').isNumber() && newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 100"
        }
      }
    },

    "privacy": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "allowContactBy": {
          ".validate": "newData.val() === 'all' || newData.val() === 'nobody'"
        }
      }
    },

    "public_profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName']) && newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 100"
      }
    },

    "email_index": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.replace('.', ',').toLowerCase()",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid))",
        "messages": {
          ".indexOn": ["sentAt"],
          "$messageId": {
            ".write": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && !data.exists()",
            ".validate": "newData.hasChildren(['senderId', 'text', 'sentAt']) && newData.child('senderId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 4000"
          }
        }
      }
    },

    "user_chats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["lastMessageAt"],
        "$chatId": {
          ".write": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && ($chatId.beginsWith($uid + '_') || $chatId.endsWith('_' + $uid))",
          ".validate": "newData.hasChildren(['otherUid', 'otherDisplayName', 'lastMessage', 'lastMessageAt'])"
        }
      }
    }
  }
}
